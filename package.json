{
  "name": "apr-research-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts --host 0.0.0.0",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts && node scripts/check-build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps/web/src apps/web/tests",
    "test": "vitest run",
    "test:db": "node --test supabase/tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "echarts": "6.0.0",
    "papaparse": "5.5.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.9.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.18.6",
    "@types/papaparse": "5.3.16",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "eslint": "9.36.0",
    "jsdom": "27.0.0",
    "prettier": "^3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
